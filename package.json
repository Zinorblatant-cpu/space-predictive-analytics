{
  "name": "space-predictive-analytics",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.1.0",
    "expo": "~54.0.8",
    "expo-dev-client": "~6.0.0",
    "expo-font": "~14.0.0",
    "expo-linear-gradient": "~15.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~5.1.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.0.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.8.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/(?!.*native-testing-library)|@expo-google-fonts|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|expo-router)"
    ],
    "moduleNameMapper": {
      "^@expo/vector-icons$": "<rootDir>/__mocks__/@expo/vector-icons.js",
      "^@expo/vector-icons/(.*)$": "<rootDir>/__mocks__/@expo/vector-icons.js",
      "^expo-font$": "<rootDir>/__mocks__/expo-font.js",
      "^expo-router$": "<rootDir>/__mocks__/expo-router.js",
      "^test-renderer$": "<rootDir>/node_modules/react-test-renderer/index.js",
      "^test-renderer/(.*)$": "<rootDir>/node_modules/react-test-renderer/$1"
    }
  },
  "private": true
}
